{
  "name": "strideboard-leaderboard",
  "productName": "StrideBoard Leaderboard",
  "version": "1.3.0",
  "description": "StrideBoard leaderboards (Students and Teachers) for a school screen: today, this week, this month or all time, with name search.",
  "author": "StrideBoard team",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.strideboard.leaderboard",
    "productName": "StrideBoard Leaderboard",
    "files": [
      "main.js",
      "preload.js",
      "setup.html"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.education",
      "identity": null
    },
    "dmg": {
      "artifactName": "StrideBoard-Leaderboard.dmg",
      "title": "StrideBoard Leaderboard"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "compression": "maximum",
    "electronLanguages": [
      "en",
      "en-US",
      "en-GB"
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "StrideBoard-Leaderboard.exe",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "StrideBoard Leaderboard",
      "deleteAppDataOnUninstall": false
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SohamBhongade/StrideBoard.git"
  },
  "homepage": "https://strideboard.pythonanywhere.com"
}
